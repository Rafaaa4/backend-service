# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_NAME>.mongodb.net/homeservices?retryWrites=true&w=majority

# Redis Configuration (Optional, falls back to memory cache in dev)
REDIS_URL=redis://localhost:6379

# JWT Security
# Access Token is short-lived (15 minutes)
JWT_ACCESS_SECRET=c8f8b398df98e21a3674d8120be876b0d91238475a91b2c3d4e5f60718293a4b
JWT_ACCESS_EXPIRES_IN=15m
# Refresh Token Secret
JWT_REFRESH_SECRET=7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a
JWT_REFRESH_EXPIRES_IN=7d

# Two-Factor Authentication Service Name
TWO_FACTOR_APP_NAME="Home Services TN"

# Payment Gateway (Mock / Sandbox)
PAYMENT_WEBHOOK_SECRET=whsec_homeservices_secret_9948203912
MOCK_PAYMENT_AUTO_CONFIRM=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
